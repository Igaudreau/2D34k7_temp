! WD atmosphere calculation
rtol 1e-3
derefcrit 0.2
refcrit 0.3
screen
react tim13
msbdf
hll
noviscous

START "1 core test"
   LEVELS 1
   XYZ 1
      X 1 0.0 5e7 FREE
      SCALARS 14 ADVECT 14      !iso13
   CASE MOORE
END

! atmos 
! base density, min density, temperature, stellar mass, radius, shell mass, adiabatic/isothermal, output filename
atmos 1.2e6 1e2 6e7 2.020578e33 3.8717e8 1.01435e32 adiabatic testatmos
q
